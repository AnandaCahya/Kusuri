[Unit]
Description=Kusuri Desktop Client 24/7 Telemetry and Sync Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/kusuri-desktop run
Restart=always
RestartSec=5s
Environment=RUST_LOG=info
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
