# Kusuri Backend Configuration
# Port and host to bind the server
HOST=0.0.0.0
PORT=8080

# PostgreSQL Connection String
DATABASE_URL=postgres://postgres:kusurisecret@localhost:5432/kusuri

# Secret key for JWT auth (change this to a secure random string in production)
JWT_SECRET=super_secret_kusuri_jwt_key_change_me_in_production_1234567890

# Directory for storing uploaded files
UPLOAD_DIR=./data/uploads

# Maximum upload file size in bytes (e.g., 100MB)
MAX_UPLOAD_SIZE=104857600

# Log level (trace, debug, info, warn, error)
RUST_LOG=info,backend=debug,tower_http=info
